# Copy to .env and fill in as needed.

# Used by the app when run outside docker-compose (compose sets this itself).
DATABASE_URL=postgresql+psycopg2://ingestion:ingestion@localhost:5432/ingestion

# Directory containing source *.yaml config files.
SOURCES_CONFIG_DIR=sources_config

LOG_LEVEL=INFO

# Optional: personal access token for the GitHub demo source. Unauthenticated
# requests work fine too, just with a lower GitHub rate limit (60 req/hr vs 5000).
GITHUB_TOKEN=
